{

    "$schema": "https://docs.renovatebot.com/renovate-schema.json",

    "extends": [
        "config:recommended",
        ":maintainLockFilesWeekly",
        ":automergeBranch",
        ":automergeDigest",
        ":automergeMinor",
        ":automergePatch"
    ],

    "nix": { "enabled": true },

    "packageRules": [
        {
            "description": "egui and windowing stack must update in lockstep; always review",
            "matchPackageNames": [
                "egui",
                "egui-winit",
                "egui_glow",
                "egui_system_font_provider",
                "glow",
                "glutin",
                "glutin-winit",
                "winit"
            ],
            "groupName": "egui stack",
            "automerge": false
        }
    ],

    "automergeStrategy": "rebase",
    "fetchChangeLogs": "branch"

}
